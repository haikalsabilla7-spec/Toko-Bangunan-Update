# Port server API
PORT=4000

# Koneksi PostgreSQL (server temanmu). Contoh:
# postgres://user:password@host:5432/nama_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/toko_bangunan

# Rahasia untuk menandatangani token login (JWT). WAJIB diganti dengan string acak panjang!
JWT_SECRET=ganti-dengan-string-acak-yang-sangat-panjang-dan-rahasia
JWT_EXPIRES_IN=12h

# Domain front-end yang boleh mengakses API (CORS).
# Untuk banyak domain, pisahkan dengan koma. Gunakan * hanya saat development.
CORS_ORIGIN=http://localhost:5173
